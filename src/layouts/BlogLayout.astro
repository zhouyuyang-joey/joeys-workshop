---
import * as CONFIG from '../config';
import '../styles/global.css';
import { Image } from 'astro:assets';
import joeysworkshop from '../img/joeysworkshop.png';

type Props = {
  frontmatter: CONFIG.Frontmatter;
};

const { frontmatter } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en" class="initial dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title ? `${frontmatter.title} - Joey's Workshop` : "Joey's Workshop"}</title>
    <meta name="description" content={frontmatter.description || CONFIG.SITE.description} />
  </head>

  <body class="min-h-screen bg-background text-gray-50">
    <header class="border-b border-lineHighlight">
      <nav class="max-w-6xl mx-auto px-6 py-6 site-header">
        <h1 class="text-2xl font-bold text-primary">
          <a href="/">
            <Image src={joeysworkshop} alt={CONFIG.SITE.title} width={180} class="h-10" />
          </a>
        </h1>
      </nav>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12">
      <article class="prose prose-invert max-w-none">
        <h1>{frontmatter.title}</h1>
        <slot />
      </article>
    </main>

    <footer class="border-t border-lineHighlight mt-12">
      <div class="max-w-6xl mx-auto px-6 py-6 text-center text-gray-400 text-sm">
        <p>© 2026 Joey's Workshop. </p>
      </div>
    </footer>
  </body>
</html>
